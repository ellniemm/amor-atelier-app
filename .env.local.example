# ==== NextAuth ====
# Generate string acak panjang, misalnya lewat: openssl rand -base64 32
NEXTAUTH_SECRET=ganti_dengan_random_string_panjang
NEXTAUTH_URL=http://localhost:3000

# ==== User 1 (misalnya kamu) ====
USER1_NAME=Adelweis
USER1_USERNAME=adelweis
USER1_PASSWORD_HASH=

# ==== User 2 (partner) ====
USER2_NAME=Partner
USER2_USERNAME=partner
USER2_PASSWORD_HASH=

# ==== Google Sheets ====
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=isi_dengan_id_spreadsheet

# Nama tab di Google Sheets kamu (sesuaikan kalau beda)
SHEET_TAB_PEMBUKUAN=Pembukuan
SHEET_TAB_ORDERS=Order List

# Tab ini akan DIBUAT OTOMATIS oleh aplikasi kalau belum ada, tidak perlu
# kamu buat manual di Google Sheets.
SHEET_TAB_DAILY_REPORT=Daily Report

# ==== Google Drive (upload moodboard) ====
# ID folder Google Drive tujuan upload file moodboard.
# Cara ambil: buka folder di Drive, ambil bagian setelah /folders/ di URL.
# WAJIB: share folder ini ke email service account sebagai Editor.
GOOGLE_DRIVE_FOLDER_ID=isi_dengan_id_folder_drive

# ==== Google Drive OAuth (upload moodboard atas nama akun kamu) ====
# Service account tidak punya kuota storage, jadi upload dijalankan atas
# nama akun Gmail kamu via OAuth. Setup sekali:
#   1. Google Cloud Console → Credentials → OAuth client ID (Web application,
#      redirect URI: http://localhost:3000)
#   2. Isi CLIENT_ID & CLIENT_SECRET di bawah
#   3. node scripts/get-drive-token.js  → ikuti petunjuknya
#   4. Simpan refresh token yang tercetak ke GOOGLE_OAUTH_REFRESH_TOKEN
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
